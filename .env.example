AGENT_MONITOR_HOST=127.0.0.1
AGENT_MONITOR_PORT=8787
AGENT_MONITOR_TOKEN=
AGENT_MONITOR_DATA_DIR=.agent-monitor
AGENT_MONITOR_POLL_MS=2500
# 历史保留天数，默认 14 天；<= 0 表示永久保留
# 注意：超期数据会在服务启动时立即永久删除，之后每小时再清理一次；调小该值并重启会立刻删掉新窗口以外的数据
# 收藏的历史、未结束的任务、待处理的审批不会被清理
AGENT_MONITOR_HISTORY_DAYS=14
AGENT_MONITOR_APPROVAL_TIMEOUT_MS=570000
AGENT_MONITOR_CODEX_APPROVAL_TTL_MS=120000
AGENT_MONITOR_WINDOWS_PS=1
AGENT_MONITOR_WINDOWS_PS_CACHE_MS=10000

VITE_API_BASE=http://127.0.0.1:8787
VITE_AGENT_MONITOR_TOKEN=
